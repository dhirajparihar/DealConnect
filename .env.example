# Application Configuration
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000/api/v1
SESSION_SECRET=super-secret-session-key-must-be-at-least-32-chars
ENCRYPTION_KEY=32-byte-hex-encryption-key-sample-1234

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dealconnect?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379

# Object Storage (S3 compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=dealconnect-media
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# Messaging / OTP
OTP_PROVIDER=mock
OTP_API_KEY=dummy_otp_key
OTP_SENDER_ID=DEALCN

# WhatsApp Provider
WHATSAPP_PROVIDER=mock
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=dummy_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=100020003000
WHATSAPP_WEBHOOK_SECRET=dummy_webhook_secret

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
ERROR_TRACKING_DSN=

# Rate Limits
OTP_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100
PUBLIC_API_RATE_LIMIT_MAX=30
