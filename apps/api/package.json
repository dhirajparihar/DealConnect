    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@dealconnect/shared-types": "*",
    "@dealconnect/validation": "*",
    "@prisma/client": "^5.21.1",
    "@types/bcrypt": "^5.0.2",
