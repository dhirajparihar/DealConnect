{
  "name": "@dealconnect/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run build --workspace=@dealconnect/shared-types && npm run build --workspace=@dealconnect/validation && tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
